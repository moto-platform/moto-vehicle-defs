 SG_ E2E_COUNTER : 8|4@1+ (1,0) [0|15] "" SAFETY,LINUX
 SG_ LEAN_STATUS : 12|4@1+ (1,0) [0|15] "" SAFETY,LINUX
 SG_ LEAN_ANGLE : 16|16@1- (0.01,0) [-90|90] "deg" SAFETY,LINUX
 SG_ LEAN_RATE : 32|16@1- (0.01,0) [-300|300] "deg/s" SAFETY,LINUX
