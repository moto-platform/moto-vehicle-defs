VAL_ 32 LEAN_ANGLE_STATE 0 "ESTIMATED" 1 "CLAMPED" 2 "RESERVED" 3 "INVALID" ;
VAL_ 33 VEHICLE_SPEED_VALID 0 "INVALID" 1 "VALID" ;
VAL_ 34 FRICTION_COEFF_STATE 0 "ESTIMATED" 1 "CLAMPED" 2 "DEFAULT" 3 "INVALID" ;
VAL_ 34 TOTAL_MASS_STATE 0 "ESTIMATED" 1 "CLAMPED" 2 "DEFAULT" 3 "INVALID" ;
VAL_ 129 NODE_MODE 0 "INIT" 1 "NORMAL" 2 "DEGRADED" 3 "SAFE_STATE" 4 "BOOTLOADER" 5 "DIAGNOSTIC" ;
VAL_ 130 NODE_MODE 0 "INIT" 1 "NORMAL" 2 "DEGRADED" 3 "SAFE_STATE" 4 "BOOTLOADER" 5 "DIAGNOSTIC" ;
