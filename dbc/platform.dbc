BO_ 32 EkfLean: 8 RT_CORE
 SG_ E2E_CRC : 0|8@1+ (1,0) [0|255] "" SAFETY,LINUX
 SG_ E2E_COUNTER : 8|4@1+ (1,0) [0|15] "" SAFETY,LINUX
 SG_ LEAN_ANGLE_STATE : 12|2@1+ (1,0) [0|3] "" SAFETY,LINUX
 SG_ LEAN_ANGLE : 16|16@1- (0.01,0) [-90|90] "deg" SAFETY,LINUX
 SG_ LEAN_ANGLE_QUALITY : 32|8@1+ (1,0) [0|100] "%" SAFETY,LINUX

BO_ 33 VehicleSpeed: 8 RT_CORE
 SG_ E2E_CRC : 0|8@1+ (1,0) [0|255] "" SAFETY,CONN,LINUX
 SG_ E2E_COUNTER : 8|4@1+ (1,0) [0|15] "" SAFETY,CONN,LINUX
 SG_ VEHICLE_SPEED_VALID : 12|1@1+ (1,0) [0|1] "" SAFETY,CONN,LINUX
 SG_ VEHICLE_SPEED : 16|16@1+ (0.01,0) [0|300] "km/h" SAFETY,CONN,LINUX
 SG_ VEHICLE_SPEED_AGE : 32|8@1+ (10,0) [0|2550] "ms" SAFETY,CONN,LINUX

BO_ 34 EkfFrictionMass: 8 RT_CORE
 SG_ E2E_CRC : 0|8@1+ (1,0) [0|255] "" SAFETY,LINUX
 SG_ E2E_COUNTER : 8|4@1+ (1,0) [0|15] "" SAFETY,LINUX
 SG_ FRICTION_COEFF_STATE : 12|2@1+ (1,0) [0|3] "" SAFETY,LINUX
 SG_ TOTAL_MASS_STATE : 14|2@1+ (1,0) [0|3] "" SAFETY,LINUX
 SG_ FRICTION_COEFF : 16|16@1+ (0.001,0) [0|2] "" SAFETY,LINUX
 SG_ FRICTION_COEFF_QUALITY : 32|8@1+ (1,0) [0|100] "%" SAFETY,LINUX
 SG_ TOTAL_MASS : 40|16@1+ (0.1,0) [0|1000] "kg" SAFETY,LINUX
 SG_ TOTAL_MASS_QUALITY : 56|8@1+ (1,0) [0|100] "%" SAFETY,LINUX

BO_ 129 HeartbeatRtCore: 8 RT_CORE
 SG_ E2E_CRC : 0|8@1+ (1,0) [0|255] "" SAFETY,IO,CONN,LINUX
 SG_ E2E_COUNTER : 8|4@1+ (1,0) [0|15] "" SAFETY,IO,CONN,LINUX
 SG_ NODE_MODE : 12|4@1+ (1,0) [0|15] "" SAFETY,IO,CONN,LINUX
 SG_ ERROR_COUNT : 16|8@1+ (1,0) [0|255] "" SAFETY,IO,CONN,LINUX
 SG_ UPTIME : 24|16@1+ (1,0) [0|65535] "s" SAFETY,IO,CONN,LINUX

